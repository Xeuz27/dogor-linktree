---
//@ts-nocheck
import { addHour, format } from '@formkit/tempo';

const days = {
    tuesday: 'tuesday',
    wednesday: 'wednesday',
    thursday: 'thursday',
    friday: 'friday',
    saturday: 'saturday',
    sunday: 'sunday',
};

const date = new Date();

let dia = format(date, 'dddd').toLowerCase();
let horasActual = format(addHour(date, -4), 'HHmm');
let horasActualNumber = parseInt(horasActual, 10);

const isValidDay = days[dia];
const diasExtendidos = ['friday', 'saturday', 'sunday'];
const horaCierre = diasExtendidos.includes(dia) ? 2359 : 2330;
const isOpen = isValidDay && horasActualNumber > 1730 && horasActualNumber < horaCierre;

let classes = isOpen
    ? 'text-green-500 font-semibold underline decoration-green-500 underline-offset-1 text-xl text-center'
    : 'text-red-500 font-semibold underline decoration-red-500 underline-offset-1 text-xl text-center';
let texto = isOpen ? 'Abierto' : 'Cerrado';
---

<span class={classes}>{texto}</span>
