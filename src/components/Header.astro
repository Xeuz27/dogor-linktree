---
const { title } = Astro.props;
import IsOpen from './IsOpen.astro';
---

<header class="flex h-full flex-col items-center gap-4 px-4 py-4">
    <section class="flex h-fit w-full flex-col gap-4">
        <div class="flex items-center justify-center gap-2">
            <h1
                class="text-balance text-center text-[20px] font-bold leading-6 tracking-tight text-white min-[360px]:text-[24px] min-[425px]:text-[26px] md:text-3xl md:tracking-normal"
            >
                {title}{' '}
                🍔
            </h1>
        </div>
        <div class="mx-auto min-h-fit w-[60%] sm:p-0">
            <figure>
                <picture>
                    <source srcset="/dogor-logo.webp" type="image/webp" />
                    <source srcset="/dogor-logo.jpg" type="image/jpg" />
                    <img
                        class="mx-auto h-full max-h-24 rounded-full"
                        decoding="async"
                        loading="eager"
                        src="/dogor-logo.webp"
                        alt="logo de Dogor Gourmet"
                    />
                </picture>
            </figure>
        </div>
    </section>
    <div class="flex flex-col justify-center gap-1.5 min-[426px]:justify-start">
        <ul class="flex justify-center gap-x-2 text-sm text-gray-200/80">
            <li>
                <a
                    title="visitar el perfil de instagram @dogorgourmet"
                    href="https://www.instagram.com/dogorgourmet/">@dogorgourmet</a
                >
            </li>
        </ul>
        <h2 class="text-pretty text-sm leading-none tracking-wide text-white">
            Hamburguersas <strong>Gourmet y tradicionales</strong> ~ Restaurante <span
                class="text-lg">👨‍🍳</span
            >
        </h2>
        <div
            class="flex flex-col gap-1 text-pretty text-sm font-semibold leading-[14px] tracking-wider text-white/90"
        >
            <p>Martes a Domingo</p>
            <p>De 5:30 PM a 11:30 PM 📅</p>
        </div>
        <IsOpen server:defer>
            <span slot="fallback" class="text-center text-white"> Cargando </span>
        </IsOpen>
        <h3 class="text-sm leading-tight tracking-wide text-gray-50/80">
            #hamburguesas #Gourmet #Tradicional | Mcbo Ve
        </h3>
    </div>
</header>
